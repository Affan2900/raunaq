# Copy this file to `.env` at the project root and fill in values from:
# Firebase Console → Project settings (gear) → General → Your apps → Web app
# (If you have no Web app, click "Add app" → Web and register localhost.)

FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_BUCKET=

# Android (Project settings → Your apps → Android); required for Android builds
FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=

# iOS / macOS (Your apps → Apple); required for iOS and macOS builds
FIREBASE_IOS_API_KEY=
FIREBASE_IOS_APP_ID=

# FAQ assistant — optional FastAPI proxy (POST /chat, JSON {query,messages} -> {reply}). No trailing slash.
# When set, the app calls this first; FAQ text is loaded on the server. Falls back to Callable / OpenRouter if unset.
FAQ_ASSISTANT_BASE_URL=
# Optional shared secret your FastAPI checks (sent as Authorization: Bearer ...)
# FAQ_ASSISTANT_API_KEY=

# FAQ assistant (OpenRouter fallback). Prefer proxy or Firebase Callable `faqChat`; direct key is unsafe on web.
OPENROUTER_API_KEY=
# Model id on OpenRouter (default openai/gpt-4o-mini). Examples: anthropic/claude-3.5-haiku, google/gemma-2-9b-it
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional OpenRouter attribution headers (see OpenRouter docs)
# OPENROUTER_HTTP_REFERER=https://yoursite.example
# OPENROUTER_APP_NAME=Raunaq
